<Window x:Class="QuestDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuestDemo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
  <StackPanel Margin="20" VerticalAlignment="Center">
    <TextBlock Text="Xuất báo cáo" FontSize="16" FontWeight="Bold" Margin="0,0,0,20" />

    <ProgressBar x:Name="ProgressBarExport" Height="25" Minimum="0" Maximum="100" />
    <TextBlock x:Name="ProgressText" Text="0%" HorizontalAlignment="Center" Margin="0,5,0,10"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button x:Name="BtnExport" Content="Export PDF" Width="120" Click="BtnExport_Click"/>
      <Button x:Name="BtnCancel" Content="Hủy" Width="100" Click="BtnCancel_Click" IsEnabled="False"/>
    </StackPanel>

    <TextBlock x:Name="StatusText" Text="" HorizontalAlignment="Center" Margin="0,10,0,0" />
  </StackPanel>
</Window>
