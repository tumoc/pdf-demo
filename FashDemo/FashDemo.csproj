<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

	<ItemGroup>
		<Content Include="Reports\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Assets\background.jpg" />
	  <None Remove="Assets\download.jpg" />
	  <None Remove="Assets\Logo.png" />
	  <None Remove="Assets\Screenshot_6.png" />
	  <None Remove="Assets\Screenshot_7.png" />
	  <None Remove="Assets\Screenshot_8.png" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="Assets\background.jpg">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Assets\download.jpg">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Assets\Logo.png">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Assets\Screenshot_6.png">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Assets\Screenshot_7.png">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Assets\Screenshot_8.png">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>
  <ItemGroup>
    <PackageReference Include="FastReport.OpenSource" Version="2025.2.12" />
    <PackageReference Include="FastReport.OpenSource.Export.PdfSimple" Version="2025.2.12" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Reports\ProductList.frx" />
  </ItemGroup>

</Project>
