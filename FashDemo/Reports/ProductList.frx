			<TextObject Name="HeaderTitle" Width="700" Height="30" Font="Arial, 14pt, style=Bold" Text="Danh sách sản phẩm" HorzAlign="Center"/>
			<LineObject Top="35" Width="700"/>
		</PageHeaderBand>

		<DataBand Name="Data1" Height="60" DataSource="Products" Bookmark="[Products.Id]">
			<TextObject Name="Id" Left="10" Width="40" Height="20" Text="[Products.Id]" Font="Arial, 10pt"/>
			<TextObject Name="Name" Left="60" Width="200" Height="20" Text="[Products.Name]" Font="Arial, 10pt, style=Bold"/>
			<TextObject Name="Price" Left="270" Width="100" Height="20" Text="[Products.Price]" Format="Currency"/>
